[
 {
  "start": 0.25,
  "end": 1.134,
  "text": "Cyber safety.",
  "shot": "S1"
 },
 {
  "start": 1.134,
  "end": 3.582,
  "text": "Five things every student must know.",
  "shot": "S1"
 },
 {
  "start": 4.182,
  "end": 4.607,
  "text": "First,",
  "shot": "S2"
 },
 {
  "start": 4.607,
  "end": 6.376,
  "text": "digital arrest is a scam.",
  "shot": "S2"
 },
 {
  "start": 6.376,
  "end": 9.42,
  "text": "No police officer or agency arrests anyone,",
  "shot": "S2"
 },
 {
  "start": 9.42,
  "end": 10.623,
  "text": "or demands money,",
  "shot": "S2"
 },
 {
  "start": 10.623,
  "end": 12.534,
  "text": "over a phone or video call.",
  "shot": "S2"
 },
 {
  "start": 13.134,
  "end": 13.455,
  "text": "Next,",
  "shot": "S3"
 },
 {
  "start": 13.455,
  "end": 14.801,
  "text": "scammers create fear,",
  "shot": "S3"
 },
 {
  "start": 14.801,
  "end": 17.11,
  "text": "urgency and secrecy. Pause, hang up,",
  "shot": "S3"
 },
 {
  "start": 17.11,
  "end": 19.034,
  "text": "and talk to someone you trust.",
  "shot": "S3"
 },
 {
  "start": 19.634,
  "end": 19.999,
  "text": "Also,",
  "shot": "S4"
 },
 {
  "start": 19.999,
  "end": 21.533,
  "text": "never share your OTP,",
  "shot": "S4"
 },
 {
  "start": 21.533,
  "end": 23.287,
  "text": "UPI PIN or card details.",
  "shot": "S4"
 },
 {
  "start": 23.287,
  "end": 26.063,
  "text": "You never need a PIN to receive money.",
  "shot": "S4"
 },
 {
  "start": 26.663,
  "end": 27.539,
  "text": "And remember,",
  "shot": "S5"
 },
 {
  "start": 27.539,
  "end": 31.108,
  "text": "genuine employers do not ask for registration fees or",
  "shot": "S5"
 },
 {
  "start": 31.108,
  "end": 32.994,
  "text": "security deposits for a job.",
  "shot": "S5"
 },
 {
  "start": 33.594,
  "end": 34.368,
  "text": "And remember,",
  "shot": "S6"
 },
 {
  "start": 34.368,
  "end": 36.275,
  "text": "if someone threatens you online,",
  "shot": "S6"
 },
 {
  "start": 36.275,
  "end": 36.93,
  "text": "do not pay.",
  "shot": "S6"
 },
 {
  "start": 36.93,
  "end": 37.824,
  "text": "Save the chats,",
  "shot": "S6"
 },
 {
  "start": 37.824,
  "end": 39.73,
  "text": "block the account and report it.",
  "shot": "S6"
 },
 {
  "start": 39.73,
  "end": 40.981,
  "text": "It is not your fault.",
  "shot": "S6"
 },
 {
  "start": 41.581,
  "end": 45.332,
  "text": "The National Cyber Crime Helpline number is 1930.",
  "shot": "S7"
 },
 {
  "start": 45.932,
  "end": 50.677,
  "text": "You can also report cybercrime online at cybercrime.gov.in.",
  "shot": "S8"
 }
]