[
 {
  "start": 0.25,
  "end": 1.123,
  "text": "Cyber safety.",
  "shot": "S1"
 },
 {
  "start": 1.123,
  "end": 3.541,
  "text": "Four things every student must know.",
  "shot": "S1"
 },
 {
  "start": 4.141,
  "end": 4.566,
  "text": "First,",
  "shot": "S2"
 },
 {
  "start": 4.566,
  "end": 6.335,
  "text": "digital arrest is a scam.",
  "shot": "S2"
 },
 {
  "start": 6.335,
  "end": 9.379,
  "text": "No police officer or agency arrests anyone,",
  "shot": "S2"
 },
 {
  "start": 9.379,
  "end": 10.582,
  "text": "or demands money,",
  "shot": "S2"
 },
 {
  "start": 10.582,
  "end": 12.493,
  "text": "over a phone or video call.",
  "shot": "S2"
 },
 {
  "start": 13.093,
  "end": 13.457,
  "text": "Next,",
  "shot": "S3"
 },
 {
  "start": 13.457,
  "end": 14.986,
  "text": "never share your OTP,",
  "shot": "S3"
 },
 {
  "start": 14.986,
  "end": 16.734,
  "text": "UPI PIN or card details.",
  "shot": "S3"
 },
 {
  "start": 16.734,
  "end": 19.5,
  "text": "You never need a PIN to receive money.",
  "shot": "S3"
 },
 {
  "start": 20.1,
  "end": 20.449,
  "text": "Also,",
  "shot": "S4"
 },
 {
  "start": 20.449,
  "end": 24.152,
  "text": "genuine employers do not ask for registration fees or",
  "shot": "S4"
 },
 {
  "start": 24.152,
  "end": 26.108,
  "text": "security deposits for a job.",
  "shot": "S4"
 },
 {
  "start": 26.708,
  "end": 27.482,
  "text": "And remember,",
  "shot": "S5"
 },
 {
  "start": 27.482,
  "end": 29.389,
  "text": "if someone threatens you online,",
  "shot": "S5"
 },
 {
  "start": 29.389,
  "end": 30.044,
  "text": "do not pay.",
  "shot": "S5"
 },
 {
  "start": 30.044,
  "end": 30.938,
  "text": "Save the chats,",
  "shot": "S5"
 },
 {
  "start": 30.938,
  "end": 32.844,
  "text": "block the account and report it.",
  "shot": "S5"
 },
 {
  "start": 32.844,
  "end": 34.095,
  "text": "It is not your fault.",
  "shot": "S5"
 },
 {
  "start": 34.695,
  "end": 38.446,
  "text": "The National Cyber Crime Helpline number is 1930.",
  "shot": "S6"
 },
 {
  "start": 39.046,
  "end": 43.791,
  "text": "You can also report cybercrime online at cybercrime.gov.in.",
  "shot": "S7"
 }
]