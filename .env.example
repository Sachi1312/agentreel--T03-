# Key NAMES only. This project needs NO paid keys. Never commit a real .env.
TEAM_ID=T00
# rules (default, offline, free) | ollama (local open model, free)
LLM_PROVIDER=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# auto = kokoro (offline neural, default) -> edge-tts -> espeak.   Or force one: kokoro | edge | espeak
TTS_PROVIDER=auto
# Kokoro voices: af_heart (default, warm female) af_bella af_nicole bf_emma (British female) am_michael am_adam bm_george ...
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.98
# used only if edge-tts is selected
TTS_VOICE=en-IN-NeerjaNeural
